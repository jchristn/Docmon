<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================ Build ============================ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>docmon</AssemblyName>
    <RootNamespace>Docmon.App</RootNamespace>
    <NeutralLanguage>en-US</NeutralLanguage>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- ========================== Versioning ========================= -->
  <PropertyGroup>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1-alpha</InformationalVersion>
  </PropertyGroup>

  <!-- =================== Global tool / NuGet package =============== -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>docmon</ToolCommandName>
    <RollForward>Major</RollForward>

    <PackageId>Docmon</PackageId>
    <Title>Docmon</Title>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Product>Docmon</Product>
    <Copyright>Copyright (c) 2026 Joel Christner</Copyright>
    <Description>Docmon is a keyboard-driven, multi-pane terminal UI for managing and monitoring a local Docker stack: containers, live metrics, image-update checks, lifecycle control, exec, file transfer, and an interactive shell. Runs on Windows, Linux, and macOS. This is a v0.1.1 alpha release and is subject to change.</Description>
    <PackageTags>docker;tui;terminal;monitoring;containers;devops;cli;dashboard;compose</PackageTags>
    <PackageProjectUrl>https://github.com/jchristn/Docmon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/Docmon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>DOCKERHUB_README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReleaseNotes>v0.1.1 alpha - dependency updates (TUIKit 1.2.0), fixes for container copy-out, exec output interleaving, Docker Hub error handling, and digest-pinned pulls. See CHANGELOG.md.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUIKit" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docmon.Core\Docmon.Core.csproj" />
  </ItemGroup>

  <!-- Files bundled into the NuGet package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\DOCKERHUB_README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\assets\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
