{
  "info": {
    "name": "Docmon API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Docmon single-machine monitoring and full Docker control. Set baseUrl and bearerToken in a local environment. No real credentials are committed. The complete collection includes destructive requests; select individual requests or use the read-only smoke collection. Generated from live Watson OpenAPI metadata by scripts/export-api.py."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
