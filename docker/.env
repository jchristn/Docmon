# Bearer token used by the dashboard, REST API, and MCP.
DOCMON_BEARER_TOKEN=docmonadmin
DOCMON_HOST=0.0.0.0
DOCMON_DASHBOARD_BIND=0.0.0.0
DOCMON_DASHBOARD_PORT=8088
DOCMON_API_BIND=0.0.0.0
DOCMON_API_PORT=8080
# Docker Desktop may use /Users/YOU/.docker/run/docker.sock instead.
DOCMON_DOCKER_SOCKET=/var/run/docker.sock
# Durable request history is stored in the docmon-data named volume.
