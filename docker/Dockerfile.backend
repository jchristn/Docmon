FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /build
COPY Directory.Build.props ./
COPY src/Docmon.Core/ src/Docmon.Core/
COPY src/Docmon.Server/ src/Docmon.Server/
RUN dotnet publish src/Docmon.Server/Docmon.Server.csproj -c Release -f net10.0 -o /app

FROM mcr.microsoft.com/dotnet/runtime:10.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl docker.io docker-compose-v2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/ ./
ENV DOCMON_HOST=0.0.0.0 DOCMON_PORT=8080 DOCMON_MCP_PORT=8081 DOCKER_HOST=unix:///var/run/docker.sock
EXPOSE 8080
ENTRYPOINT ["dotnet", "Docmon.Server.dll"]
